{
  "schema": "agent-companion/usage-analysis",
  "schemaVersion": 1,
  "revision": 1,
  "$comment": "Shipped global scenarios only. Anything that depends on one machine (windows, exclusions, plan size, experiments) belongs in the user layer: see usage-analysis.example.json.",
  "defaults": {
    "threshold": {
      "relPct": 25,
      "minSample": 15,
      "minDays": 1
    }
  },
  "scenarios": [
    {
      "id": "day.units",
      "title": "Plan units per day",
      "metric": "day.units",
      "compare": [
        "prior-day",
        "trailing-7"
      ],
      "threshold": {
        "direction": "up-is-worse"
      },
      "severity": "info",
      "cadence": "daily"
    },
    {
      "id": "day.byClass",
      "title": "Units by session class",
      "metric": "day.byClass",
      "compare": [
        "trailing-7"
      ],
      "threshold": {
        "direction": "up-is-worse"
      },
      "severity": "info",
      "cadence": "daily"
    },
    {
      "id": "day.byProject",
      "title": "Units by project",
      "metric": "day.byProject",
      "compare": [
        "trailing-7"
      ],
      "threshold": {
        "direction": "up-is-worse"
      },
      "severity": "info",
      "cadence": "daily"
    },
    {
