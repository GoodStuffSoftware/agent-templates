      "metric": "day.limitHits",
      "compare": [
        "trailing-7"
      ],
      "threshold": {
        "direction": "up-is-worse",
        "abs": 1,
        "minSample": 1
      },
      "severity": "info",
      "cadence": "daily"
    },
    {
      "id": "day.hours",
      "title": "Units by hour and share over 150K",
      "metric": "day.hours",
      "compare": [
        "trailing-7"
      ],
      "threshold": {
        "direction": "up-is-worse"
      },
      "severity": "info",
      "cadence": "daily"
    },
    {
      "id": "day.excludedShare",
      "title": "Units removed by each exclusion",
      "metric": "day.excludedShare",
      "compare": [
        "trailing-7"
      ],
      "threshold": {
        "direction": "up-is-worse"
      },
      "severity": "info",
      "cadence": "daily"
    },
